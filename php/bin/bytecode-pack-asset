#!/usr/bin/env php
<?php

declare(strict_types=1);

if ($argc !== 3 || in_array($argv[1] ?? '', ['-h', '--help'], true)) {
    fwrite(STDERR, "Usage: bytecode-pack-asset <asset-input> <container-output>\n");
    fwrite(STDERR, "\nEnvironment:\n  BYTECODE_DEK, BYTECODE_KEY, OPDUMP_KEY, or BYTECODE_VENDOR_KEY\n");
    fwrite(STDERR, "    64 hex chars / 32 bytes. Treated as HKDF-SHA256 input keying material.\n");
    exit(($argc === 2 && in_array($argv[1], ['-h', '--help'], true)) ? 0 : 2);
}

$assetPath = $argv[1];
$outPath = $argv[2];
$vendorKeyFile = getenv('BYTECODE_VENDOR_KEY_FILE') ?: dirname(__DIR__, 2) . DIRECTORY_SEPARATOR . 'build' . DIRECTORY_SEPARATOR . 'vendor-secret.key';
if (!is_file($vendorKeyFile) && !getenv('BYTECODE_DEK') && !getenv('BYTECODE_KEY') && !getenv('OPDUMP_KEY') && !getenv('BYTECODE_VENDOR_KEY')) {
    if (!is_dir(dirname($vendorKeyFile)) && !@mkdir(dirname($vendorKeyFile), 0770, true) && !is_dir(dirname($vendorKeyFile))) {
        fwrite(STDERR, "cannot create vendor key directory: " . dirname($vendorKeyFile) . "\n");
        exit(1);
    }
    file_put_contents($vendorKeyFile, bin2hex(random_bytes(32)) . PHP_EOL);
    @chmod($vendorKeyFile, 0600);
}
$fileKey = is_file($vendorKeyFile) ? trim((string) file_get_contents($vendorKeyFile)) : '';
$hexKey = getenv('BYTECODE_DEK') ?: getenv('BYTECODE_KEY') ?: getenv('OPDUMP_KEY') ?: getenv('BYTECODE_VENDOR_KEY') ?: $fileKey;

if (!preg_match('/\A[0-9a-fA-F]{64}\z/', $hexKey)) {
    fwrite(STDERR, "BYTECODE_DEK/BYTECODE_KEY/OPDUMP_KEY/BYTECODE_VENDOR_KEY must be exactly 64 hex characters\n");
    exit(1);
}

$plain = file_get_contents($assetPath);
if ($plain === false) {
    fwrite(STDERR, "cannot read asset: {$assetPath}\n");
    exit(1);
}

$ikm = hex2bin($hexKey);
$keyId = random_bytes(16);
$key = hash_hkdf('sha256', $ikm, 32, 'bytecode-v2', $keyId);
$nonce = random_bytes(12);
$cipherId = 1; // AES-256-GCM
$backendId = 'bytecode-asset';
$backendFormat = 'RAW1';
$phpVersionId = PHP_VERSION_ID;

$header = 'BYTC'
    . pack('V', 2)
    . pack('V', $phpVersionId)
    . pack('V', strlen($backendId)) . $backendId
    . pack('V', strlen($backendFormat)) . $backendFormat
    . pack('V', $cipherId)
    . pack('V', strlen($keyId)) . $keyId;

$tag = '';
$ciphertext = openssl_encrypt(
    $plain,
    'aes-256-gcm',
    $key,
    OPENSSL_RAW_DATA,
    $nonce,
    $tag,
    $header,
    16
);

if ($ciphertext === false) {
    fwrite(STDERR, "AES-256-GCM encryption failed\n");
    exit(1);
}

$container = $header
    . pack('V', strlen($nonce)) . $nonce
    . pack('V', strlen($tag)) . $tag
    . pack('P', strlen($ciphertext)) . $ciphertext;

if (file_put_contents($outPath, $container) === false) {
    fwrite(STDERR, "cannot write container: {$outPath}\n");
    exit(1);
}
