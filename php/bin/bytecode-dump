#!/usr/bin/env php
<?php

declare(strict_types=1);

require_once __DIR__ . '/bytecode-common.php';

/*
 * Phase 1 tree dumper: walk PHP source and emit encrypted BYTC2 containers.
 * Uses lint mode (-l) so PHP compiles each file without executing it. Static
 * assets use the same BYTC2 envelope with a raw-asset backend.
 *
 * Rewritten from the original Bash version so this tool runs the same way
 * on Linux, macOS, and Windows -- it only depends on the PHP CLI itself
 * (proc_open, realpath(), hash_file()), not on sh/realpath(1)/sha256sum/mktemp.
 */

function usage(): void
{
    fwrite(STDERR, <<<'USAGE'
Usage:
  bytecode-dump [options] <source-file-or-dir>... <output-dir>
  bytecode-dump [options] --out <output-dir> <source-file-or-dir>...

  --obfuscate  Rename non-parameter local variables to _v0, _v1, ... in the
               dumped bytecode. Off by default. Skipped per-function whenever
               compact()/extract()/get_defined_vars()/$$name/call_user_func()-
               style dynamic dispatch is detected, so it never risks changing
               behavior -- see opdump_op_array_uses_dynamic_vars() in
               php/src/opdump.c.
  --scan       Run bytecode-scan before dumping and write scan diagnostics into
               bytecode.manifest.json.

Options:
  --raw                         Write raw .opd2 bytecode blobs instead of encrypted containers.
                                PHP files only; asset containers are encrypted
                                deployable output.
  --dry-run                     Report what would be encoded/skipped without writing output.
  --report-json                 With --dry-run, print a JSON fail-closed report.
  --profile <name>              Apply include/exclude defaults. Built-ins:
                                php-only, php-assets, laravel, slim, symfony,
                                codeigniter, wordpress-plugin,
                                wordpress-theme, yii, cakephp, full-app.
  --include-assets              Also encode .html/.htm/.css/.js/.mjs/.twig/
                                .blade.php files as encrypted raw asset
                                containers. Off by default.
  --obfuscate                   Enable safe local-variable obfuscation.
  --scan                        Run bytecode-scan first and embed the scan report.
  --fail-on-scan-warning        Fail if bytecode-scan reports warnings.
  --config <bytecode.json>      Read default exclude/scanner options from config.
  --exclude <glob>              Exclude paths. Repeatable. Also supports --exclude=<glob>.
  --out <dir>, -o <dir>         Output directory. Alternative to final positional argument.
  --key <hex>                   64-hex shared key. Same as BYTECODE_KEY.
  --opdump-key <hex>            64-hex legacy/shared key. Same as OPDUMP_KEY.
  --vendor-key <hex>            64-hex vendor key compiled into your custom loader.
  --vendor-key-file <path>      64-hex vendor key file. Defaults to
                                build/vendor-secret.key and is auto-created
                                when missing.
  --vendor-sign-key <path>      Ed25519 private key (bytecode-vendor-keygen) used
                                to write bytecode.seal.json -- a vendor signature
                                over manifest+map+license. A loader built/config-
                                ured with the matching public key refuses any
                                package whose files or license rules were altered.
  --license-pubkey <path>       Encode in license mode with this RSA public key.
  --machine-id <id>             Bind the signed package policy to
                                OPDUMP_MACHINE_ID on the server. In license
                                mode this is also written to bytecode.license.json.
  --domains <csv>               License mode: allowed HTTP_HOST/SERVER_NAME values.
  --ips <csv>                   License mode: allowed SERVER_ADDR values.
  --hostnames <csv>             License mode: allowed system hostnames.
  --fingerprints <csv>          License mode: allowed OPDUMP_MACHINE_FINGERPRINT values.
  --expires-at <YYYY-MM-DD>     License mode: UTC expiry date.
  --license-id <id>             License/customer tracking and revocation id.
  --customer-id <id>            Customer id metadata.
  --features <csv>              Feature flag metadata.
  --watermark <text>            Encrypted/customer watermark metadata.
  --activation-url <url>        Online activation endpoint metadata.
  --activation-token <token>    Require matching OPDUMP_ACTIVATION_TOKEN.
  --revocation-url <url>        Revocation endpoint metadata.
  --unlock-policy <policy>      Metadata/enforcement policy name.
  --strip-paths                 Store virtual filenames in bytecode metadata.
  --virtual-root <prefix>       Prefix for --strip-paths. Default: bytecode://
  --php-bin <path>              PHP binary used to compile source. Same as PHP_BIN.
  --opdump-so <path>            Loader extension path. Same as OPDUMP_SO.
  -h, --help                    Show this help.

Environment:
  PHP_BIN      PHP binary to use (default: php8.4)
  OPDUMP_SO    Path to opdump.so/opdump.dll (default: ../src/modules/<name>)
  BYTECODE_KEY or OPDUMP_KEY
               64 hex chars / 32 bytes, required unless --raw or
               BYTECODE_LICENSE_PUBKEY is used
  BYTECODE_LICENSE_PUBKEY
               Path to a license.pub.pem (see bytecode-license-keygen).
               When set, one random DEK is generated for this whole run and
               RSA-OAEP-SHA256-wrapped into bytecode.license.json instead of
               using BYTECODE_KEY/OPDUMP_KEY directly.
  BYTECODE_VENDOR_KEY
               64 hex chars matching --with-opdump-vendor-secret at loader
               build time; avoids server-side BYTECODE_KEY configuration.
  BYTECODE_VENDOR_KEY_FILE
               Path to the default vendor-secret key file.
  BYTECODE_VENDOR_SIGN_KEY
               Path to the vendor Ed25519 private key (bytecode-vendor-keygen).
               Same as --vendor-sign-key. When set, bytecode.seal.json is
               written and the package is bound to your vendor public key.

USAGE);
}

function fail(string $message, int $code = 1): never
{
    fwrite(STDERR, $message . PHP_EOL);
    exit($code);
}

function take_option_value(array &$args, string $option): string
{
    array_shift($args);
    if (!$args) {
        fail("{$option} requires a value", 2);
    }
    return array_shift($args);
}

function load_bytecode_config(?string $path): array
{
    if ($path === null || $path === '') {
        $candidate = getcwd() . DIRECTORY_SEPARATOR . 'bytecode.json';
        if (!is_file($candidate)) {
            return [];
        }
        $path = $candidate;
    }

    if (!is_file($path)) {
        fail("config file does not exist: {$path}", 2);
    }
    $decoded = json_decode((string) file_get_contents($path), true);
    if (!is_array($decoded)) {
        fail("invalid JSON config: {$path}", 2);
    }
    return $decoded;
}

function config_list(array $config, string $key): array
{
    $value = $config[$key] ?? [];
    if ($value === null) {
        return [];
    }
    if (!is_array($value)) {
        fail("bytecode.json field '{$key}' must be an array", 2);
    }
    return array_values(array_filter($value, static fn (mixed $item): bool => is_string($item) && $item !== ''));
}

function read_or_create_key_file(string $path): string
{
    if (is_file($path)) {
        $key = trim((string) file_get_contents($path));
        if (!preg_match('/\A[0-9a-fA-F]{64}\z/', $key)) {
            fail("vendor key file must contain exactly 64 hex characters: {$path}");
        }
        return $key;
    }

    $dir = dirname($path);
    if (!is_dir($dir) && !@mkdir($dir, 0770, true) && !is_dir($dir)) {
        fail("cannot create vendor key directory: {$dir}");
    }
    $key = bin2hex(random_bytes(32));
    if (file_put_contents($path, $key . PHP_EOL) === false) {
        fail("cannot write vendor key file: {$path}");
    }
    @chmod($path, 0600);
    fwrite(STDERR, "generated vendor key file: {$path}\n");
    return $key;
}

function scanner_config(array $config): array
{
    $scanner = $config['scanner'] ?? [];
    if ($scanner === null) {
        return [];
    }
    if (!is_array($scanner)) {
        fail("bytecode.json field 'scanner' must be an object", 2);
    }
    return $scanner;
}

/** Translate a shell-style glob (`*`, `?`) into an anchored regex; no fnmatch() dependency (absent on Windows). */
function glob_to_regex(string $glob): string
{
    $regex = '';
    for ($i = 0, $n = strlen($glob); $i < $n; $i++) {
        $c = $glob[$i];
        if ($c === '*') {
            $regex .= '.*';
        } elseif ($c === '?') {
            $regex .= '.';
        } else {
            $regex .= preg_quote($c, '#');
        }
    }
    return '#\A' . $regex . '\z#';
}

function is_excluded(string $rel, array $excludes): bool
{
    foreach ($excludes as $pattern) {
        if (preg_match(glob_to_regex($pattern), $rel)) {
            return true;
        }
    }
    return false;
}

/** Forward-slash relative path regardless of host path separator, so manifest/map entries are portable. */
function to_rel(string $base, string $path): string
{
    $rel = substr($path, strlen($base));
    $rel = ltrim($rel, '/\\');
    return str_replace('\\', '/', $rel);
}

function run_subprocess(array $cmd, array $envOverrides): int
{
    $prevValues = [];
    foreach ($envOverrides as $name => $value) {
        $prevValues[$name] = getenv($name);
        putenv($value === null ? $name : "{$name}={$value}");
    }

    $descriptors = [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']];
    $proc = proc_open($cmd, $descriptors, $pipes);
    if ($proc === false) {
        foreach ($prevValues as $name => $value) {
            putenv($value === false ? $name : "{$name}={$value}");
        }
        fail('failed to start subprocess: ' . implode(' ', $cmd));
    }
    fclose($pipes[0]);
    stream_get_contents($pipes[1]);
    $stderr = stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);
    $exit = proc_close($proc);

    foreach ($prevValues as $name => $value) {
        putenv($value === false ? $name : "{$name}={$value}");
    }

    if ($exit !== 0 && $stderr !== '') {
        fwrite(STDERR, $stderr);
    }
    return $exit;
}

function run_capture(array $cmd): array
{
    $descriptors = [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']];
    $proc = proc_open($cmd, $descriptors, $pipes);
    if ($proc === false) {
        fail('failed to start subprocess: ' . implode(' ', $cmd));
    }
    fclose($pipes[0]);
    $stdout = stream_get_contents($pipes[1]);
    $stderr = stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);
    $exit = proc_close($proc);
    return [$exit, $stdout, $stderr];
}

function run_scan(
    string $phpBin,
    string $scanner,
    array $sources,
    array $excludes,
    ?string $configPath,
    bool $failOnWarning
): array {
    $cmd = [$phpBin, $scanner, '--json'];
    if ($failOnWarning) {
        $cmd[] = '--fail-on-warning';
    }
    if ($configPath !== null && $configPath !== '') {
        $cmd[] = '--config';
        $cmd[] = $configPath;
    }
    foreach ($excludes as $exclude) {
        $cmd[] = '--exclude';
        $cmd[] = $exclude;
    }
    array_push($cmd, ...$sources);

    [$exit, $stdout, $stderr] = run_capture($cmd);
    if ($exit !== 0) {
        if ($stderr !== '') {
            fwrite(STDERR, $stderr);
        }
        if ($stdout !== '') {
            fwrite(STDERR, $stdout);
        }
        fail('bytecode-scan failed', $exit);
    }

    $decoded = json_decode($stdout, true);
    if (!is_array($decoded) || ($decoded['format'] ?? '') !== 'bytecode-scan-v1') {
        fail('bytecode-scan returned invalid JSON');
    }
    return $decoded;
}

/**
 * RSA-OAEP-SHA256-wraps $plaintext with the given public key by shelling out
 * to the openssl CLI. PHP's openssl_public_encrypt() only supports OAEP with
 * a hardcoded SHA-1 digest -- there is no core-PHP function to choose
 * SHA-256 for OAEP/MGF1, so the wrap step goes through `openssl pkeyutl`
 * instead, matching the explicit SHA-256 digest opdump.c's loader requires
 * on unwrap (see opdump_rsa_unwrap_dek in php/src/opdump.c).
 */
function openssl_rsa_oaep_sha256_wrap(string $publicKeyPath, string $plaintext): string
{
    $cmd = [
        'openssl', 'pkeyutl', '-encrypt',
        '-pubin', '-inkey', $publicKeyPath,
        '-pkeyopt', 'rsa_padding_mode:oaep',
        '-pkeyopt', 'rsa_oaep_md:sha256',
        '-pkeyopt', 'rsa_mgf1_md:sha256',
    ];
    $descriptors = [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']];
    $proc = proc_open($cmd, $descriptors, $pipes);
    if ($proc === false) {
        fail('failed to start openssl pkeyutl for RSA-OAEP wrap');
    }
    fwrite($pipes[0], $plaintext);
    fclose($pipes[0]);
    $stdout = stream_get_contents($pipes[1]);
    fclose($pipes[1]);
    $stderr = stream_get_contents($pipes[2]);
    fclose($pipes[2]);
    $exit = proc_close($proc);

    if ($exit !== 0) {
        fwrite(STDERR, $stderr);
        fail('openssl pkeyutl RSA-OAEP wrap failed -- is the openssl CLI installed and is the public key valid PEM?');
    }
    return $stdout;
}

/**
 * Ed25519-signs $message with the vendor private key via the openssl CLI.
 * Ed25519 is a one-shot signature over the raw message (no prehash), which
 * PHP's openssl_sign()/OPENSSL_ALGO_* cannot express -- so, like the RSA-OAEP
 * wrap above, this shells out to `openssl pkeyutl -sign -rawin`. The loader
 * verifies the resulting 64-byte signature with EVP_DigestVerify (Ed25519).
 */
function openssl_ed25519_sign(string $privateKeyPath, string $message): string
{
    // Ed25519 is a one-shot signature and `openssl pkeyutl -sign -rawin` needs a
    // seekable input to size it -- a pipe fails with "unable to determine file
    // size for oneshot operation" -- so the message goes through a temp file.
    $msgTmp = tempnam(sys_get_temp_dir(), 'seal-msg');
    if ($msgTmp === false || file_put_contents($msgTmp, $message) === false) {
        fail('cannot create temporary file for Ed25519 sign');
    }
    $cmd = ['openssl', 'pkeyutl', '-sign', '-inkey', $privateKeyPath, '-rawin', '-in', $msgTmp];
    $descriptors = [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']];
    $proc = proc_open($cmd, $descriptors, $pipes);
    if ($proc === false) {
        @unlink($msgTmp);
        fail('failed to start openssl pkeyutl for Ed25519 sign');
    }
    fclose($pipes[0]);
    $stdout = stream_get_contents($pipes[1]);
    fclose($pipes[1]);
    $stderr = stream_get_contents($pipes[2]);
    fclose($pipes[2]);
    $exit = proc_close($proc);
    @unlink($msgTmp);

    if ($exit !== 0 || strlen($stdout) !== 64) {
        fwrite(STDERR, $stderr);
        fail('openssl pkeyutl Ed25519 sign failed -- is the vendor sign key a valid Ed25519 PEM (see bytecode-vendor-keygen)?');
    }
    return $stdout;
}

/** Raw 32-byte Ed25519 public key derived from a private key PEM, as 64 hex chars. */
function ed25519_pubkey_hex(string $privateKeyPath): string
{
    $cmd = ['openssl', 'pkey', '-in', $privateKeyPath, '-pubout', '-outform', 'DER'];
    $descriptors = [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']];
    $proc = proc_open($cmd, $descriptors, $pipes);
    if ($proc === false) {
        fail('failed to start openssl pkey for Ed25519 public key extraction');
    }
    fclose($pipes[0]);
    $der = stream_get_contents($pipes[1]);
    fclose($pipes[1]);
    fclose($pipes[2]);
    $exit = proc_close($proc);
    if ($exit !== 0 || strlen($der) !== 44) {
        fail('could not derive Ed25519 public key from vendor sign key');
    }
    return bin2hex(substr($der, 12, 32));
}

function seal_policy_fields(array $licenseFields): array
{
    $keys = [
        'machine_id',
        'domains',
        'ips',
        'hostnames',
        'fingerprints',
        'expires_at',
        'license_id',
        'activation_token',
        'revocation_url',
        'unlock_policy',
    ];
    $policy = [];
    foreach ($keys as $key) {
        $value = $licenseFields[$key] ?? null;
        if ($value !== null && $value !== '') {
            $policy[$key] = $value;
        }
    }
    return $policy;
}

function seal_policy_message(array $policy): string
{
    $keys = [
        'machine_id',
        'domains',
        'ips',
        'hostnames',
        'fingerprints',
        'expires_at',
        'license_id',
        'activation_token',
        'revocation_url',
        'unlock_policy',
    ];
    $message = "bytecode-seal-policy-v1\n";
    foreach ($keys as $key) {
        $message .= $key . ':' . (($policy[$key] ?? '') !== '' ? $policy[$key] : '-') . "\n";
    }
    return $message;
}

$args = array_slice($argv, 1);
if (isset($args[0]) && in_array($args[0], ['-h', '--help'], true)) {
    usage();
    exit(0);
}

$raw = false;
$dryRun = false;
$reportJson = false;
$includeAssets = false;
$includeAssetsExplicit = false;
$obfuscate = false;
$scan = false;
$failOnScanWarning = false;
$profile = null;
$configPath = null;
$excludes = [];
$out = null;
$phpBinOption = null;
$opdumpSoOption = null;
$bytecodeKeyOption = null;
$opdumpKeyOption = null;
$vendorKeyOption = null;
$vendorKeyFileOption = null;
$vendorSignKeyOption = null;
$licensePubkeyOption = null;
$machineIdOption = null;
$domainsOption = null;
$ipsOption = null;
$hostnamesOption = null;
$fingerprintsOption = null;
$expiresAtOption = null;
$licenseIdOption = null;
$customerIdOption = null;
$featuresOption = null;
$watermarkOption = null;
$activationUrlOption = null;
$activationTokenOption = null;
$revocationUrlOption = null;
$unlockPolicyOption = null;
$stripPaths = false;
$virtualRootOption = null;
while ($args) {
    $a = $args[0];
    if ($a === '--raw') {
        $raw = true;
        array_shift($args);
        continue;
    }
    if ($a === '--dry-run') {
        $dryRun = true;
        array_shift($args);
        continue;
    }
    if ($a === '--report-json') {
        $reportJson = true;
        array_shift($args);
        continue;
    }
    if ($a === '--profile') {
        $profile = take_option_value($args, '--profile');
        continue;
    }
    if (str_starts_with($a, '--profile=')) {
        $profile = substr($a, strlen('--profile='));
        array_shift($args);
        continue;
    }
    if ($a === '--include-assets') {
        $includeAssets = true;
        $includeAssetsExplicit = true;
        array_shift($args);
        continue;
    }
    if ($a === '--obfuscate') {
        $obfuscate = true;
        array_shift($args);
        continue;
    }
    if ($a === '--scan') {
        $scan = true;
        array_shift($args);
        continue;
    }
    if ($a === '--fail-on-scan-warning') {
        $scan = true;
        $failOnScanWarning = true;
        array_shift($args);
        continue;
    }
    if ($a === '--config') {
        $configPath = take_option_value($args, '--config');
        continue;
    }
    if (str_starts_with($a, '--config=')) {
        $configPath = substr($a, strlen('--config='));
        array_shift($args);
        continue;
    }
    if ($a === '--exclude') {
        $excludes[] = take_option_value($args, '--exclude');
        continue;
    }
    if (str_starts_with($a, '--exclude=')) {
        $excludes[] = substr($a, strlen('--exclude='));
        array_shift($args);
        continue;
    }
    if ($a === '--out' || $a === '-o') {
        $out = take_option_value($args, $a);
        continue;
    }
    if (str_starts_with($a, '--out=')) {
        $out = substr($a, strlen('--out='));
        array_shift($args);
        continue;
    }
    if ($a === '--key') {
        $bytecodeKeyOption = take_option_value($args, '--key');
        continue;
    }
    if (str_starts_with($a, '--key=')) {
        $bytecodeKeyOption = substr($a, strlen('--key='));
        array_shift($args);
        continue;
    }
    if ($a === '--opdump-key') {
        $opdumpKeyOption = take_option_value($args, '--opdump-key');
        continue;
    }
    if (str_starts_with($a, '--opdump-key=')) {
        $opdumpKeyOption = substr($a, strlen('--opdump-key='));
        array_shift($args);
        continue;
    }
    if ($a === '--vendor-key') {
        $vendorKeyOption = take_option_value($args, '--vendor-key');
        continue;
    }
    if (str_starts_with($a, '--vendor-key=')) {
        $vendorKeyOption = substr($a, strlen('--vendor-key='));
        array_shift($args);
        continue;
    }
    if ($a === '--vendor-key-file') {
        $vendorKeyFileOption = take_option_value($args, '--vendor-key-file');
        continue;
    }
    if (str_starts_with($a, '--vendor-key-file=')) {
        $vendorKeyFileOption = substr($a, strlen('--vendor-key-file='));
        array_shift($args);
        continue;
    }
    if ($a === '--vendor-sign-key') {
        $vendorSignKeyOption = take_option_value($args, '--vendor-sign-key');
        continue;
    }
    if (str_starts_with($a, '--vendor-sign-key=')) {
        $vendorSignKeyOption = substr($a, strlen('--vendor-sign-key='));
        array_shift($args);
        continue;
    }
    if ($a === '--license-pubkey') {
        $licensePubkeyOption = take_option_value($args, '--license-pubkey');
        continue;
    }
    if (str_starts_with($a, '--license-pubkey=')) {
        $licensePubkeyOption = substr($a, strlen('--license-pubkey='));
        array_shift($args);
        continue;
    }
    if ($a === '--machine-id') {
        $machineIdOption = take_option_value($args, '--machine-id');
        continue;
    }
    if (str_starts_with($a, '--machine-id=')) {
        $machineIdOption = substr($a, strlen('--machine-id='));
        array_shift($args);
        continue;
    }
    foreach ([
        '--domains' => 'domainsOption',
        '--ips' => 'ipsOption',
        '--hostnames' => 'hostnamesOption',
        '--fingerprints' => 'fingerprintsOption',
        '--expires-at' => 'expiresAtOption',
        '--license-id' => 'licenseIdOption',
        '--customer-id' => 'customerIdOption',
        '--features' => 'featuresOption',
        '--watermark' => 'watermarkOption',
        '--activation-url' => 'activationUrlOption',
        '--activation-token' => 'activationTokenOption',
        '--revocation-url' => 'revocationUrlOption',
        '--unlock-policy' => 'unlockPolicyOption',
        '--virtual-root' => 'virtualRootOption',
    ] as $optName => $varName) {
        if ($a === $optName) {
            $$varName = take_option_value($args, $optName);
            continue 2;
        }
        if (str_starts_with($a, $optName . '=')) {
            $$varName = substr($a, strlen($optName) + 1);
            array_shift($args);
            continue 2;
        }
    }
    if ($a === '--strip-paths') {
        $stripPaths = true;
        array_shift($args);
        continue;
    }
    if ($a === '--php-bin') {
        $phpBinOption = take_option_value($args, '--php-bin');
        continue;
    }
    if (str_starts_with($a, '--php-bin=')) {
        $phpBinOption = substr($a, strlen('--php-bin='));
        array_shift($args);
        continue;
    }
    if ($a === '--opdump-so') {
        $opdumpSoOption = take_option_value($args, '--opdump-so');
        continue;
    }
    if (str_starts_with($a, '--opdump-so=')) {
        $opdumpSoOption = substr($a, strlen('--opdump-so='));
        array_shift($args);
        continue;
    }
    if ($a === '--') {
        array_shift($args);
        break;
    }
    if ($a !== '' && $a[0] === '-') {
        usage();
        exit(2);
    }
    break;
}

if ($out === null && count($args) < 2) {
    usage();
    exit(2);
}
if ($out === null) {
    $out = array_pop($args);
}
if ($args === []) {
    usage();
    exit(2);
}
$sources = $args;

$config = load_bytecode_config($configPath);
$scannerConfig = scanner_config($config);
$profile = $profile ?: (($config['profile'] ?? null) ?: null);

function bytecode_profile(string $profile): array
{
    return match ($profile) {
        'php-only' => [
            'include_assets' => false,
            'exclude' => ['vendor/*', 'storage/*', 'node_modules/*', '.git/*', '.history/*'],
        ],
        'php-assets' => [
            'include_assets' => true,
            'exclude' => ['vendor/*', 'storage/*', 'node_modules/*', '.git/*', '.history/*'],
        ],
        'laravel' => [
            'include_assets' => true,
            'exclude' => ['vendor/*', 'storage/*', 'bootstrap/cache/*', 'node_modules/*', '.git/*', '.history/*'],
        ],
        'slim' => [
            'include_assets' => true,
            'exclude' => ['vendor/*', 'var/cache/*', 'var/log/*', 'storage/*', 'node_modules/*', '.git/*', '.history/*'],
        ],
        'symfony' => [
            'include_assets' => true,
            'exclude' => ['vendor/*', 'var/cache/*', 'var/log/*', 'node_modules/*', '.git/*', '.history/*'],
        ],
        'codeigniter' => [
            'include_assets' => true,
            'exclude' => ['vendor/*', 'writable/cache/*', 'writable/logs/*', 'writable/session/*', 'node_modules/*', '.git/*', '.history/*'],
        ],
        'wordpress-plugin' => [
            'include_assets' => true,
            'exclude' => ['vendor/*', 'node_modules/*', '.git/*', '.history/*', 'tests/*'],
        ],
        'wordpress-theme' => [
            'include_assets' => true,
            'exclude' => ['vendor/*', 'node_modules/*', '.git/*', '.history/*', 'screenshot.png'],
        ],
        'yii' => [
            'include_assets' => true,
            'exclude' => ['vendor/*', 'runtime/*', 'web/assets/*', 'node_modules/*', '.git/*', '.history/*'],
        ],
        'cakephp' => [
            'include_assets' => true,
            'exclude' => ['vendor/*', 'tmp/*', 'logs/*', 'node_modules/*', '.git/*', '.history/*'],
        ],
        'full-app' => [
            'include_assets' => true,
            'exclude' => ['.git/*', '.history/*', 'node_modules/*'],
        ],
        default => fail("unknown profile '{$profile}' (expected php-only, php-assets, laravel, slim, symfony, codeigniter, wordpress-plugin, wordpress-theme, yii, cakephp, full-app)", 2),
    };
}

$profileConfig = is_string($profile) && $profile !== '' ? bytecode_profile($profile) : [];
$excludes = array_values(array_unique([...($profileConfig['exclude'] ?? []), ...config_list($config, 'exclude'), ...$excludes]));
if (($config['assets']['include'] ?? false) === true || ($config['include_assets'] ?? false) === true) {
    $includeAssets = true;
}
if (($profileConfig['include_assets'] ?? null) === true) {
    $includeAssets = true;
} elseif (($profileConfig['include_assets'] ?? null) === false && !$includeAssetsExplicit && !isset($config['assets']['include']) && !isset($config['include_assets'])) {
    $includeAssets = false;
}
if (($scannerConfig['enabled'] ?? false) === true) {
    $scan = true;
}
if (($scannerConfig['fail_on_warning'] ?? false) === true) {
    $failOnScanWarning = true;
}

$scriptDir = __DIR__;
$phpBin = $phpBinOption ?: (getenv('PHP_BIN') ?: 'php8.4');
$defaultSoName = PHP_OS_FAMILY === 'Windows' ? 'opdump.dll' : 'opdump.so';
$opdumpSo = $opdumpSoOption ?: (getenv('OPDUMP_SO') ?: $scriptDir . '/../src/modules/' . $defaultSoName);
$packer = $scriptDir . '/bytecode-pack';
$assetPacker = $scriptDir . '/bytecode-pack-asset';
$scanner = $scriptDir . '/bytecode-scan';
$repoRoot = dirname($scriptDir, 2);
$defaultVendorKeyFile = $vendorKeyFileOption
    ?: (getenv('BYTECODE_VENDOR_KEY_FILE') ?: $repoRoot . DIRECTORY_SEPARATOR . 'build' . DIRECTORY_SEPARATOR . 'vendor-secret.key');

if (!$raw && !is_file($assetPacker)) {
    fail("asset packer not found at {$assetPacker}");
}
if (!$dryRun && !is_dir($out) && !@mkdir($out, 0777, true) && !is_dir($out)) {
    fail("cannot create output directory: {$out}");
}
$outAbs = realpath($out);
if ($outAbs === false && !$dryRun) {
    fail("cannot resolve output directory: {$out}");
}
$outAbs = $outAbs ?: rtrim($out, DIRECTORY_SEPARATOR);

function php_version_id(string $phpBin): int
{
    $descriptors = [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']];
    $proc = proc_open([$phpBin, '-r', 'echo PHP_VERSION_ID;'], $descriptors, $pipes);
    if ($proc === false) {
        fail("failed to run {$phpBin} to determine PHP_VERSION_ID");
    }
    fclose($pipes[0]);
    $stdout = stream_get_contents($pipes[1]);
    fclose($pipes[1]);
    fclose($pipes[2]);
    proc_close($proc);
    return (int) trim($stdout);
}

$phpVersionId = php_version_id($phpBin);

$licensePubkey = $licensePubkeyOption ?: (getenv('BYTECODE_LICENSE_PUBKEY') ?: null);
$vendorSignKey = $vendorSignKeyOption ?: (getenv('BYTECODE_VENDOR_SIGN_KEY') ?: null);
if ($vendorSignKey !== null && $vendorSignKey !== '' && !is_file($vendorSignKey)) {
    fail("vendor sign key does not exist: {$vendorSignKey}");
}
$machineId = $machineIdOption ?: (getenv('BYTECODE_MACHINE_ID') ?: null);
$licenseFields = [
    'machine_id' => $machineId,
    'domains' => $domainsOption ?: getenv('BYTECODE_LICENSE_DOMAINS') ?: null,
    'ips' => $ipsOption ?: getenv('BYTECODE_LICENSE_IPS') ?: null,
    'hostnames' => $hostnamesOption ?: getenv('BYTECODE_LICENSE_HOSTNAMES') ?: null,
    'fingerprints' => $fingerprintsOption ?: getenv('BYTECODE_LICENSE_FINGERPRINTS') ?: null,
    'expires_at' => $expiresAtOption ?: getenv('BYTECODE_LICENSE_EXPIRES_AT') ?: null,
    'license_id' => $licenseIdOption ?: getenv('BYTECODE_LICENSE_ID') ?: null,
    'customer_id' => $customerIdOption ?: getenv('BYTECODE_CUSTOMER_ID') ?: null,
    'features' => $featuresOption ?: getenv('BYTECODE_FEATURES') ?: null,
    'watermark' => $watermarkOption ?: getenv('BYTECODE_WATERMARK') ?: null,
    'activation_url' => $activationUrlOption ?: getenv('BYTECODE_ACTIVATION_URL') ?: null,
    'activation_token' => $activationTokenOption ?: getenv('BYTECODE_ACTIVATION_TOKEN') ?: null,
    'revocation_url' => $revocationUrlOption ?: getenv('BYTECODE_REVOCATION_URL') ?: null,
    'unlock_policy' => $unlockPolicyOption ?: getenv('BYTECODE_UNLOCK_POLICY') ?: null,
];
$hasLicensePolicy = count(array_filter($licenseFields, static fn ($value): bool => $value !== null && $value !== '')) > 0;
if ($hasLicensePolicy && ($licensePubkey === null || $licensePubkey === '') && ($vendorSignKey === null || $vendorSignKey === '')) {
    fail('machine/license policy options require either --license-pubkey or --vendor-sign-key so the policy is cryptographically bound', 2);
}
$dekHex = null;
if ($licensePubkey !== null && $licensePubkey !== '') {
    if (!is_file($licensePubkey)) {
        fail("license public key does not exist: {$licensePubkey}");
    }
    if (!$raw) {
        $dekHex = bin2hex(random_bytes(32));
    }
}
// Same IKM every container in this run is HKDF-derived from (see bytecode-pack
// and opdump_resolve_ikm() in php/src/opdump.c); used again below to sign
// bytecode.manifest.json + bytecode.map so tampering with the map's source-to-
// container wiring is detectable, not just tampering with a single container.
$envOrOptionKey = $bytecodeKeyOption ?: $opdumpKeyOption ?: $vendorKeyOption ?: getenv('BYTECODE_KEY') ?: getenv('OPDUMP_KEY') ?: getenv('BYTECODE_VENDOR_KEY') ?: '';
$defaultVendorKey = (!$dryRun && !$raw && $dekHex === null && $envOrOptionKey === '')
    ? read_or_create_key_file($defaultVendorKeyFile)
    : '';
$ikmHex = $dekHex ?? ($envOrOptionKey ?: $defaultVendorKey);
if (!$dryRun && !$raw && $dekHex === null && !preg_match('/\A[0-9a-fA-F]{64}\z/', $ikmHex)) {
    fail('a 64-hex key is required; pass --key, --vendor-key, set BYTECODE_KEY/BYTECODE_VENDOR_KEY, configure build/vendor-secret.key, or use --license-pubkey', 2);
}

$manifestFiles = [];
$mapLines = [];

function source_kind(string $path): ?string
{
    if (str_ends_with(strtolower(str_replace('\\', '/', $path)), '.blade.php')) {
        return 'asset';
    }
    return match (strtolower(pathinfo($path, PATHINFO_EXTENSION))) {
        'php' => 'php',
        'html', 'htm', 'css', 'js', 'mjs', 'twig' => 'asset',
        default => null,
    };
}

function is_supported_source(string $path, bool $includeAssets): bool
{
    $kind = source_kind($path);
    return $kind === 'php' || ($includeAssets && $kind === 'asset');
}

function content_type_for_path(string $path): string
{
    if (str_ends_with(strtolower(str_replace('\\', '/', $path)), '.blade.php')) {
        return 'text/x-blade; charset=utf-8';
    }
    return match (strtolower(pathinfo($path, PATHINFO_EXTENSION))) {
        'css' => 'text/css; charset=utf-8',
        'js', 'mjs' => 'text/javascript; charset=utf-8',
        'html', 'htm', 'twig' => 'text/html; charset=utf-8',
        default => 'application/octet-stream',
    };
}

function path_parts(string $path): array
{
    $path = str_replace('\\', '/', $path);
    $prefix = '';
    if (preg_match('#\A[A-Za-z]:/#', $path) === 1) {
        $prefix = substr($path, 0, 2);
        $path = substr($path, 2);
    }
    $parts = array_values(array_filter(explode('/', trim($path, '/')), static fn (string $part): bool => $part !== ''));
    if ($prefix !== '') {
        array_unshift($parts, $prefix);
    }
    return $parts;
}

function path_from_parts(array $parts): string
{
    if (!$parts) {
        return DIRECTORY_SEPARATOR;
    }
    if (preg_match('#\A[A-Za-z]:\z#', $parts[0]) === 1) {
        $drive = array_shift($parts);
        return $drive . DIRECTORY_SEPARATOR . implode(DIRECTORY_SEPARATOR, $parts);
    }
    return DIRECTORY_SEPARATOR . implode(DIRECTORY_SEPARATOR, $parts);
}

function common_base(array $paths): string
{
    $common = path_parts(array_shift($paths));
    foreach ($paths as $path) {
        $parts = path_parts($path);
        $limit = min(count($common), count($parts));
        $next = [];
        for ($i = 0; $i < $limit; $i++) {
            if ($common[$i] !== $parts[$i]) {
                break;
            }
            $next[] = $common[$i];
        }
        $common = $next;
    }
    return path_from_parts($common);
}

$sourceAbsList = [];
foreach ($sources as $source) {
    if (!file_exists($source)) {
        fail("source path does not exist: {$source}");
    }
    $sourceAbs = realpath($source);
    if ($sourceAbs === false) {
        fail("cannot resolve source path: {$source}");
    }
    $sourceAbsList[] = $sourceAbs;
}

$multiSource = count($sourceAbsList) > 1;
$commonInputs = [];
foreach ($sourceAbsList as $sourceAbs) {
    $commonInputs[] = $multiSource
        ? (is_dir($sourceAbs) ? dirname($sourceAbs) : dirname($sourceAbs))
        : (is_dir($sourceAbs) ? $sourceAbs : dirname($sourceAbs));
}
$relativeBase = common_base($commonInputs);

$scanReport = null;
if ($scan) {
    if (!is_file($scanner)) {
        fail("bytecode scanner not found at {$scanner}");
    }
    $scanReport = run_scan($phpBin, $scanner, $sourceAbsList, $excludes, $configPath, $failOnScanWarning);
    fwrite(
        STDOUT,
        sprintf(
            "bytecode-scan: scanned %d file(s), %d warning(s)\n",
            $scanReport['files_scanned'] ?? 0,
            $scanReport['warning_count'] ?? 0,
        ),
    );
}

function collect_plan_files(array $sourceAbsList, bool $multiSource, string $relativeBase, bool $includeAssets, array $excludes): array
{
    $planned = [];
    $skipped = [];
    foreach ($sourceAbsList as $srcAbs) {
        if (is_file($srcAbs)) {
            $kind = source_kind($srcAbs);
            $rel = $multiSource ? to_rel($relativeBase, $srcAbs) : basename($srcAbs);
            if ($kind === null) {
                $skipped[] = ['source' => str_replace('\\', '/', $srcAbs), 'reason' => 'unsupported-extension'];
            } elseif ($kind === 'asset' && !$includeAssets) {
                $skipped[] = ['source' => str_replace('\\', '/', $srcAbs), 'reason' => 'assets-disabled'];
            } elseif (is_excluded($rel, $excludes)) {
                $skipped[] = ['source' => str_replace('\\', '/', $srcAbs), 'reason' => 'excluded', 'pattern_match_target' => $rel];
            } else {
                $planned[] = [$srcAbs, $rel, $kind];
            }
            continue;
        }

        $files = [];
        $iterator = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($srcAbs, FilesystemIterator::SKIP_DOTS)
        );
        foreach ($iterator as $fileInfo) {
            if (!$fileInfo->isFile()) {
                continue;
            }
            $path = $fileInfo->getPathname();
            $rel = to_rel($multiSource ? $relativeBase : $srcAbs, $path);
            $kind = source_kind($path);
            if ($kind === null) {
                continue;
            }
            if ($kind === 'asset' && !$includeAssets) {
                $skipped[] = ['source' => str_replace('\\', '/', $path), 'reason' => 'assets-disabled', 'output' => $rel];
                continue;
            }
            if (is_excluded($rel, $excludes)) {
                $skipped[] = ['source' => str_replace('\\', '/', $path), 'reason' => 'excluded', 'output' => $rel];
                continue;
            }
            $files[] = [$path, $rel, $kind];
        }
        sort($files);
        array_push($planned, ...$files);
    }
    return [$planned, $skipped];
}

[$plannedFiles, $skippedFiles] = collect_plan_files($sourceAbsList, $multiSource, $relativeBase, $includeAssets, $excludes);

if ($dryRun) {
    $byKind = ['php' => 0, 'asset' => 0];
    $entries = [];
    foreach ($plannedFiles as [$file, $rel, $kind]) {
        $byKind[$kind]++;
        $entries[] = [
            'source' => str_replace('\\', '/', $file),
            'output' => $raw && $kind === 'php' ? "{$rel}.opd2" : $rel,
            'kind' => $kind,
            'backend' => $kind === 'php' ? 'php-zend-opdump' : 'bytecode-asset',
            'content_type' => $kind === 'asset' ? content_type_for_path($file) : null,
            'size' => filesize($file),
            'sha256' => hash_file('sha256', $file),
        ];
    }
    $report = [
        'format' => 'bytecode-dry-run-v1',
        'profile' => $profile,
        'include_assets' => $includeAssets,
        'raw' => $raw,
        'source_root' => str_replace('\\', '/', $relativeBase),
        'output_root' => str_replace('\\', '/', $outAbs),
        'planned_count' => count($entries),
        'planned_php' => $byKind['php'],
        'planned_assets' => $byKind['asset'],
        'skipped_count' => count($skippedFiles),
        'skipped' => $skippedFiles,
        'files' => $entries,
        'scan' => $scanReport,
    ];
    if ($reportJson) {
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), PHP_EOL;
    } else {
        printf(
            "bytecode-dump dry-run: %d planned (%d php, %d assets), %d skipped\n",
            $report['planned_count'],
            $report['planned_php'],
            $report['planned_assets'],
            $report['skipped_count'],
        );
        foreach ($entries as $entry) {
            printf("%-6s %s -> %s\n", $entry['kind'], $entry['source'], $entry['output']);
        }
        foreach ($skippedFiles as $entry) {
            printf("skip   %s (%s)\n", $entry['source'], $entry['reason']);
        }
    }
    exit(0);
}

function dump_one(
    string $file,
    string $rel,
    string $outAbs,
    string $phpBin,
    string $opdumpSo,
    string $packer,
    bool $raw,
    bool $obfuscate,
    bool $stripPaths,
    string $virtualRoot,
    int $phpVersionId,
    ?string $dekHex,
    string $ikmHex,
    array &$manifestFiles,
    array &$mapLines
): void {
    static $seenOutputs = [];

    $sourceAbs = realpath($file);
    if ($sourceAbs === false) {
        fail("cannot resolve source file: {$file}");
    }
    if (!is_file($opdumpSo)) {
        fail("opdump extension not found at {$opdumpSo}; build php/src first");
    }
    if (!is_file($packer)) {
        fail("bytecode packer not found at {$packer}");
    }

    // Encoded output keeps the source's own .php extension (a drop-in
    // replacement for the original file, same path shape); only --raw debug
    // output gets a distinct suffix, since it's never meant to be deployed.
    $relativeOutput = $raw ? "{$rel}.opd2" : $rel;
    if (isset($seenOutputs[$relativeOutput])) {
        fail("duplicate output path {$relativeOutput} from {$file} and {$seenOutputs[$relativeOutput]}");
    }
    $seenOutputs[$relativeOutput] = $file;

    $dumpEnv = ['OPDUMP_MODE' => 'dump'];
    if ($obfuscate) {
        $dumpEnv['OPDUMP_OBFUSCATE'] = '1';
    }
    if ($stripPaths) {
        $dumpEnv['OPDUMP_VIRTUAL_FILENAME'] = rtrim($virtualRoot, '/') . '/' . str_replace('\\', '/', $rel);
    }

    if ($raw) {
        $dest = $outAbs . DIRECTORY_SEPARATOR . $relativeOutput;
        @mkdir(dirname($dest), 0777, true);
        $exit = run_subprocess(
            [$phpBin, '-n', '-d', "extension={$opdumpSo}", '-l', $file],
            $dumpEnv + ['OPDUMP_OUT' => $dest]
        );
        if ($exit !== 0) {
            fail("dump failed for {$file}");
        }
    } else {
        $rawTmp = tempnam(sys_get_temp_dir(), 'opdump');
        if ($rawTmp === false) {
            fail('cannot create temporary file');
        }
        $dest = $outAbs . DIRECTORY_SEPARATOR . $relativeOutput;
        @mkdir(dirname($dest), 0777, true);

        $exit = run_subprocess(
            [$phpBin, '-n', '-d', "extension={$opdumpSo}", '-l', $file],
            $dumpEnv + ['OPDUMP_OUT' => $rawTmp]
        );
        if ($exit !== 0) {
            unlink($rawTmp);
            fail("dump failed for {$file}");
        }

        $packEnv = $dekHex !== null ? ['BYTECODE_DEK' => $dekHex] : ['BYTECODE_KEY' => $ikmHex];
        $exit = run_subprocess([$phpBin, $packer, $rawTmp, $dest], $packEnv);
        unlink($rawTmp);
        if ($exit !== 0) {
            fail("pack failed for {$file}");
        }

        $size = filesize($dest);
        $sha = hash_file('sha256', $dest);
        $relBytc = $relativeOutput;

        $manifestFiles[] = [
            'source' => $rel,
            'output' => $relBytc,
            'php_version_id' => $phpVersionId,
            'backend' => 'php-zend-opdump',
            'container' => 'BYTC2',
            'sha256' => $sha,
            'size' => $size,
        ];

        if (str_contains($sourceAbs, "\t") || str_contains($relBytc, "\t")) {
            fail("paths containing tabs are not supported by bytecode.map: {$sourceAbs}");
        }
        $mapLines[] = str_replace('\\', '/', $sourceAbs) . "\t" . $relBytc;
    }

    fwrite(STDOUT, "{$file} -> {$dest}\n");
}

function dump_asset_one(
    string $file,
    string $rel,
    string $outAbs,
    string $phpBin,
    string $assetPacker,
    ?string $dekHex,
    string $ikmHex,
    int $phpVersionId,
    array &$manifestFiles
): void {
    static $seenOutputs = [];

    $sourceAbs = realpath($file);
    if ($sourceAbs === false) {
        fail("cannot resolve source asset: {$file}");
    }

    $relativeOutput = $rel;
    if (isset($seenOutputs[$relativeOutput])) {
        fail("duplicate output path {$relativeOutput} from {$file} and {$seenOutputs[$relativeOutput]}");
    }
    $seenOutputs[$relativeOutput] = $file;

    $dest = $outAbs . DIRECTORY_SEPARATOR . $relativeOutput;
    @mkdir(dirname($dest), 0777, true);
    $packEnv = $dekHex !== null ? ['BYTECODE_DEK' => $dekHex] : ['BYTECODE_KEY' => $ikmHex];
    $exit = run_subprocess([$phpBin, $assetPacker, $sourceAbs, $dest], $packEnv);
    if ($exit !== 0) {
        fail("asset pack failed for {$file}");
    }

    $manifestFiles[] = [
        'source' => $rel,
        'output' => $relativeOutput,
        'php_version_id' => $phpVersionId,
        'backend' => 'bytecode-asset',
        'backend_format' => 'RAW1',
        'container' => 'BYTC2',
        'content_type' => content_type_for_path($file),
        'sha256' => hash_file('sha256', $dest),
        'size' => filesize($dest),
    ];

    fwrite(STDOUT, "{$file} -> {$dest}\n");
}

foreach ($sourceAbsList as $srcAbs) {
    if (is_file($srcAbs)) {
        $kind = source_kind($srcAbs);
        if ($kind === null || ($kind === 'asset' && !$includeAssets)) {
            fail("source file is not supported by this dump: {$srcAbs}" . ($kind === 'asset' ? " (pass --include-assets to encode assets)" : ""));
        }
        $rel = $multiSource ? to_rel($relativeBase, $srcAbs) : basename($srcAbs);
        if (is_excluded($rel, $excludes)) {
            continue;
        }
        if ($kind === 'php') {
            dump_one($srcAbs, $rel, $outAbs, $phpBin, $opdumpSo, $packer, $raw, $obfuscate, $stripPaths, $virtualRootOption ?: 'bytecode://', $phpVersionId, $dekHex, $ikmHex, $manifestFiles, $mapLines);
        } elseif ($raw) {
            fail("--raw only supports PHP bytecode output; cannot raw-dump asset {$srcAbs}", 2);
        } else {
            dump_asset_one($srcAbs, $rel, $outAbs, $phpBin, $assetPacker, $dekHex, $ikmHex, $phpVersionId, $manifestFiles);
        }
        continue;
    }

    $files = [];
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($srcAbs, FilesystemIterator::SKIP_DOTS)
    );
    foreach ($iterator as $fileInfo) {
        if ($fileInfo->isFile() && is_supported_source($fileInfo->getPathname(), $includeAssets)) {
            $files[] = $fileInfo->getPathname();
        }
    }
    sort($files);

    foreach ($files as $file) {
        $rel = to_rel($multiSource ? $relativeBase : $srcAbs, $file);
        if (is_excluded($rel, $excludes)) {
            continue;
        }
        if (source_kind($file) === 'php') {
            dump_one($file, $rel, $outAbs, $phpBin, $opdumpSo, $packer, $raw, $obfuscate, $stripPaths, $virtualRootOption ?: 'bytecode://', $phpVersionId, $dekHex, $ikmHex, $manifestFiles, $mapLines);
        } elseif ($raw) {
            continue;
        } else {
            dump_asset_one($file, $rel, $outAbs, $phpBin, $assetPacker, $dekHex, $ikmHex, $phpVersionId, $manifestFiles);
        }
    }
}

if (!$raw) {
    $protectionMode = $dekHex !== null
        ? (($machineId !== null && $machineId !== '') ? 'license-machine' : 'license')
        : (($vendorKeyOption ?: getenv('BYTECODE_VENDOR_KEY') ?: $defaultVendorKey) !== '' ? 'vendor' : 'shared-key');

    $manifest = [
        'format' => 'bytecode-manifest-v1',
        'tool_version' => bytecode_project_version(),
        'created_at' => gmdate('c'),
        'build_id' => bin2hex(random_bytes(8)),
        'php_version_id' => $phpVersionId,
        'backend' => 'php-zend-opdump',
        'container' => 'BYTC2',
        'container_version' => 2,
        'protection_mode' => $protectionMode,
        'metadata' => [
            'app_id' => basename($relativeBase),
            'profile' => $profile,
            'include_assets' => $includeAssets,
            'paths_stripped' => $stripPaths,
            'virtual_root' => $stripPaths ? ($virtualRootOption ?: 'bytecode://') : null,
            'license_id' => $licenseFields['license_id'],
            'customer_id' => $licenseFields['customer_id'],
            'features' => $licenseFields['features'],
            'watermark' => $licenseFields['watermark'],
            'revocation_url' => $licenseFields['revocation_url'],
            'activation_url' => $licenseFields['activation_url'],
            'unlock_policy' => $licenseFields['unlock_policy'],
            'vendor_key_file' => $defaultVendorKey !== '' ? str_replace('\\', '/', $defaultVendorKeyFile) : null,
        ],
        'source_root' => str_replace('\\', '/', $relativeBase),
        'source_roots' => array_map(static fn (string $source): string => str_replace('\\', '/', $source), $sourceAbsList),
        'map' => 'bytecode.map',
        'files' => $manifestFiles,
    ];
    if ($scanReport !== null) {
        $manifest['scan'] = [
            'format' => $scanReport['format'],
            'files_scanned' => $scanReport['files_scanned'],
            'warning_count' => $scanReport['warning_count'],
            'warnings' => $scanReport['warnings'],
        ];
    }

    file_put_contents(
        $outAbs . DIRECTORY_SEPARATOR . 'bytecode.manifest.json',
        json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n"
    );
    file_put_contents(
        $outAbs . DIRECTORY_SEPARATOR . 'bytecode.map',
        implode("\n", $mapLines) . ($mapLines ? "\n" : '')
    );

    if ($ikmHex !== '') {
        $manifestBytes = file_get_contents($outAbs . DIRECTORY_SEPARATOR . 'bytecode.manifest.json');
        $mapBytes = file_get_contents($outAbs . DIRECTORY_SEPARATOR . 'bytecode.map');
        $sigKey = hash_hkdf('sha256', hex2bin($ikmHex), 32, 'bytecode-manifest-auth', '');
        $sig = hash_hmac('sha256', $manifestBytes . "\0" . $mapBytes, $sigKey);
        file_put_contents(
            $outAbs . DIRECTORY_SEPARATOR . 'bytecode.manifest.sig',
            $sig . "\n"
        );
    }

    if ($dekHex !== null) {
        $wrappedDek = openssl_rsa_oaep_sha256_wrap($licensePubkey, hex2bin($dekHex));
        $license = [
            'format' => 'bytecode-license-v1',
            'alg' => 'RSA-OAEP-SHA256',
            'key_id' => bin2hex(random_bytes(8)),
            'wrapped_dek' => base64_encode($wrappedDek),
        ];
        foreach ($licenseFields as $key => $value) {
            if ($value !== null && $value !== '') {
                $license[$key] = $value;
            }
        }
        file_put_contents(
            $outAbs . DIRECTORY_SEPARATOR . 'bytecode.license.json',
            json_encode($license, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n"
        );
        fwrite(STDOUT, "wrote {$outAbs}" . DIRECTORY_SEPARATOR . "bytecode.license.json (RSA-OAEP-SHA256-wrapped DEK)\n");
    }

    // Vendor seal: an Ed25519 signature, under the vendor's own private key,
    // over the digests of manifest + map + license together. Unlike
    // bytecode.manifest.sig (HMAC keyed by material the server also holds),
    // only the vendor can produce this -- so the loader, verifying it against a
    // vendor public key it trusts, can reject any package whose manifest, map,
    // or license constraints (expiry/domains/machine_id/...) were altered after
    // encoding. This is what makes the license bindings tamper-proof.
    if ($vendorSignKey !== null && $vendorSignKey !== '') {
        $manifestPath = $outAbs . DIRECTORY_SEPARATOR . 'bytecode.manifest.json';
        $mapPath = $outAbs . DIRECTORY_SEPARATOR . 'bytecode.map';
        $licensePath = $outAbs . DIRECTORY_SEPARATOR . 'bytecode.license.json';

        $manifestSha = hash_file('sha256', $manifestPath);
        $mapSha = hash_file('sha256', $mapPath);
        $licenseSha = is_file($licensePath) ? hash_file('sha256', $licensePath) : null;
        $policy = seal_policy_fields($licenseFields);
        $policySha = $policy !== [] ? hash('sha256', seal_policy_message($policy)) : null;

        $message = "bytecode-seal-v1\n"
            . "manifest:{$manifestSha}\n"
            . "map:{$mapSha}\n"
            . 'license:' . ($licenseSha ?? '-') . "\n";
        if ($policySha !== null) {
            $message .= "policy:{$policySha}\n";
        }

        $signature = openssl_ed25519_sign($vendorSignKey, $message);
        $keyId = substr(hash('sha256', hex2bin(ed25519_pubkey_hex($vendorSignKey))), 0, 16);

        $seal = [
            'format' => 'bytecode-seal-v1',
            'alg' => 'Ed25519',
            'key_id' => $keyId,
            'manifest_sha256' => $manifestSha,
            'map_sha256' => $mapSha,
        ];
        if ($licenseSha !== null) {
            $seal['license_sha256'] = $licenseSha;
        }
        if ($policySha !== null) {
            $seal['policy_sha256'] = $policySha;
            foreach ($policy as $key => $value) {
                $seal[$key] = $value;
            }
        }
        $seal['signature'] = base64_encode($signature);

        file_put_contents(
            $outAbs . DIRECTORY_SEPARATOR . 'bytecode.seal.json',
            json_encode($seal, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n"
        );
        fwrite(STDOUT, "wrote {$outAbs}" . DIRECTORY_SEPARATOR . "bytecode.seal.json (Ed25519 vendor seal, key_id {$keyId})\n");
    }
}
