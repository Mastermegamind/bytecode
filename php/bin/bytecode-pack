#!/usr/bin/env php
<?php

// --- Rust-first dispatch -------------------------------------------------
// If a compiled Rust `bytecode-pack` is available, hand off to it (it is a
// byte-compatible reimplementation). Otherwise fall through to the PHP
// implementation below. Set BYTECODE_NO_RUST=1 to force the PHP path.
(static function (): void {
    if (getenv('BYTECODE_NO_RUST') || PHP_SAPI !== 'cli' || !function_exists('proc_open')) {
        return;
    }
    $root = getenv('BYTECODE_ROOT') ?: dirname(__DIR__, 2);
    $candidates = [];
    if ($explicit = getenv('BYTECODE_PACK_RS')) {
        $candidates[] = $explicit;
    }
    $candidates[] = $root . '/rust/target/release/bytecode-pack';
    $candidates[] = __DIR__ . '/bytecode-pack-rs';
    $bin = null;
    foreach ($candidates as $cand) {
        if ($cand !== '' && is_file($cand) && is_executable($cand)) {
            $bin = $cand;
            break;
        }
    }
    if ($bin === null) {
        return;
    }
    // Hand the Rust tool the authoritative PHP_VERSION_ID (written into the
    // container header) and the repo root (default vendor-key resolution).
    putenv('BYTECODE_PHP_VERSION_ID=' . PHP_VERSION_ID);
    if (getenv('BYTECODE_ROOT') === false) {
        putenv('BYTECODE_ROOT=' . dirname(__DIR__, 2));
    }
    global $argv;
    $forward = array_slice($argv, 1);
    $proc = @proc_open(
        array_merge([$bin], $forward),
        [0 => STDIN, 1 => STDOUT, 2 => STDERR],
        $pipes
    );
    if (!is_resource($proc)) {
        return; // could not launch -> fall back to PHP
    }
    exit(proc_close($proc));
})();
// --- end Rust-first dispatch ---------------------------------------------

if ($argc !== 3 || in_array($argv[1] ?? '', ['-h', '--help'], true)) {
    fwrite(STDERR, "Usage: bytecode-pack <raw-opd2-blob> <container-output>\n");
    fwrite(STDERR, "\nEnvironment:\n  BYTECODE_DEK, BYTECODE_KEY, OPDUMP_KEY, or BYTECODE_VENDOR_KEY\n");
    fwrite(STDERR, "    64 hex chars / 32 bytes.\n");
    fwrite(STDERR, "    Treated as HKDF-SHA256 input keying material (IKM); the actual\n");
    fwrite(STDERR, "    AES-256-GCM key is derived per file from a random key_id salt.\n");
    fwrite(STDERR, "    BYTECODE_DEK (set internally by bytecode-dump in license mode)\n");
    fwrite(STDERR, "    takes priority over BYTECODE_KEY/OPDUMP_KEY.\n");
    exit(($argc === 2 && in_array($argv[1], ['-h', '--help'], true)) ? 0 : 2);
}

$rawPath = $argv[1];
$outPath = $argv[2];
$vendorKeyFile = getenv('BYTECODE_VENDOR_KEY_FILE') ?: dirname(__DIR__, 2) . DIRECTORY_SEPARATOR . 'build' . DIRECTORY_SEPARATOR . 'vendor-secret.key';
if (!is_file($vendorKeyFile) && !getenv('BYTECODE_DEK') && !getenv('BYTECODE_KEY') && !getenv('OPDUMP_KEY') && !getenv('BYTECODE_VENDOR_KEY')) {
    if (!is_dir(dirname($vendorKeyFile)) && !@mkdir(dirname($vendorKeyFile), 0770, true) && !is_dir(dirname($vendorKeyFile))) {
        fwrite(STDERR, "cannot create vendor key directory: " . dirname($vendorKeyFile) . "\n");
        exit(1);
    }
    file_put_contents($vendorKeyFile, bin2hex(random_bytes(32)) . PHP_EOL);
    @chmod($vendorKeyFile, 0600);
}
$fileKey = is_file($vendorKeyFile) ? trim((string) file_get_contents($vendorKeyFile)) : '';
$hexKey = getenv('BYTECODE_DEK') ?: getenv('BYTECODE_KEY') ?: getenv('OPDUMP_KEY') ?: getenv('BYTECODE_VENDOR_KEY') ?: $fileKey;

if (!preg_match('/\\A[0-9a-fA-F]{64}\\z/', $hexKey)) {
    fwrite(STDERR, "BYTECODE_DEK/BYTECODE_KEY/OPDUMP_KEY/BYTECODE_VENDOR_KEY must be exactly 64 hex characters\n");
    exit(1);
}

$raw = file_get_contents($rawPath);
if ($raw === false) {
    fwrite(STDERR, "cannot read raw blob: {$rawPath}\n");
    exit(1);
}
if (substr($raw, 0, 4) !== 'OPD2') {
    fwrite(STDERR, "raw blob is not OPD2: {$rawPath}\n");
    exit(1);
}

$ikm = hex2bin($hexKey);
$keyId = random_bytes(16);
$key = hash_hkdf('sha256', $ikm, 32, 'bytecode-v2', $keyId);
$nonce = random_bytes(12);
$cipherId = 1; // AES-256-GCM
$backendId = 'php-zend-opdump';
$backendFormat = 'OPD2';
$phpVersionId = PHP_VERSION_ID;

$header = 'BYTC'
    . pack('V', 2)
    . pack('V', $phpVersionId)
    . pack('V', strlen($backendId)) . $backendId
    . pack('V', strlen($backendFormat)) . $backendFormat
    . pack('V', $cipherId)
    . pack('V', strlen($keyId)) . $keyId;

$tag = '';
$ciphertext = openssl_encrypt(
    $raw,
    'aes-256-gcm',
    $key,
    OPENSSL_RAW_DATA,
    $nonce,
    $tag,
    $header,
    16
);

if ($ciphertext === false) {
    fwrite(STDERR, "AES-256-GCM encryption failed\n");
    exit(1);
}

$container = $header
    . pack('V', strlen($nonce)) . $nonce
    . pack('V', strlen($tag)) . $tag
    . pack('P', strlen($ciphertext)) . $ciphertext;

if (file_put_contents($outPath, $container) === false) {
    fwrite(STDERR, "cannot write container: {$outPath}\n");
    exit(1);
}
