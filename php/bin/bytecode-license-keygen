#!/usr/bin/env php
<?php

declare(strict_types=1);

// --- Rust-first dispatch -------------------------------------------------
// If a compiled Rust `bytecode-license-keygen` is available, hand off to it (it
// is a byte-compatible reimplementation). Set BYTECODE_NO_RUST=1 to force PHP.
(static function (): void {
    if (getenv('BYTECODE_NO_RUST') || PHP_SAPI !== 'cli' || !function_exists('proc_open')) {
        return;
    }
    $root = getenv('BYTECODE_ROOT') ?: dirname(__DIR__, 2);
    $candidates = [];
    if ($explicit = getenv('BYTECODE_LICENSE_KEYGEN_RS')) {
        $candidates[] = $explicit;
    }
    $candidates[] = $root . '/rust/target/release/bytecode-license-keygen';
    $candidates[] = __DIR__ . '/bytecode-license-keygen-rs';
    $bin = null;
    foreach ($candidates as $cand) {
        if ($cand !== '' && is_file($cand) && is_executable($cand)) {
            $bin = $cand;
            break;
        }
    }
    if ($bin === null) {
        return;
    }
    global $argv;
    $proc = @proc_open(
        array_merge([$bin], array_slice($argv, 1)),
        [0 => STDIN, 1 => STDOUT, 2 => STDERR],
        $pipes
    );
    if (!is_resource($proc)) {
        return; // could not launch -> fall back to PHP
    }
    exit(proc_close($proc));
})();
// --- end Rust-first dispatch ---------------------------------------------

function fail(string $message, int $code = 1): never
{
    fwrite(STDERR, $message . PHP_EOL);
    exit($code);
}

if ($argc !== 2 || in_array($argv[1] ?? '', ['-h', '--help'], true)) {
    fwrite(STDERR, "Usage: bytecode-license-keygen <output-dir>\n");
    fwrite(STDERR, "\nGenerates an RSA-4096 keypair for BYTC2 license-mode key wrapping:\n");
    fwrite(STDERR, "  <output-dir>/license.key.pem  private key (chmod 600) -- keep with whoever\n");
    fwrite(STDERR, "                                runs the decoded app, never ship it with a build\n");
    fwrite(STDERR, "  <output-dir>/license.pub.pem  public key -- feed to\n");
    fwrite(STDERR, "                                BYTECODE_LICENSE_PUBKEY at encode time\n");
    exit(($argc === 2 && in_array($argv[1], ['-h', '--help'], true)) ? 0 : 2);
}

$outDir = rtrim($argv[1], DIRECTORY_SEPARATOR);
if (!is_dir($outDir) && !@mkdir($outDir, 0777, true) && !is_dir($outDir)) {
    fail("cannot create output directory: {$outDir}");
}

$privatePath = $outDir . DIRECTORY_SEPARATOR . 'license.key.pem';
$publicPath = $outDir . DIRECTORY_SEPARATOR . 'license.pub.pem';

if (file_exists($privatePath) || file_exists($publicPath)) {
    fail("refusing to overwrite existing key material in {$outDir}");
}

$pkey = openssl_pkey_new([
    'private_key_bits' => 4096,
    'private_key_type' => OPENSSL_KEYTYPE_RSA,
]);
if ($pkey === false) {
    fail('openssl_pkey_new failed: ' . (openssl_error_string() ?: 'unknown error'));
}
if (!openssl_pkey_export($pkey, $privatePem)) {
    fail('failed to export private key: ' . (openssl_error_string() ?: 'unknown error'));
}
$details = openssl_pkey_get_details($pkey);
if ($details === false) {
    fail('failed to read public key details: ' . (openssl_error_string() ?: 'unknown error'));
}

if (file_put_contents($privatePath, $privatePem) === false) {
    fail("cannot write {$privatePath}");
}
chmod($privatePath, 0600);
if (file_put_contents($publicPath, $details['key']) === false) {
    fail("cannot write {$publicPath}");
}

fwrite(STDOUT, "wrote {$privatePath} (keep this with whoever runs the decoded app)\n");
fwrite(STDOUT, "wrote {$publicPath} (use with BYTECODE_LICENSE_PUBKEY at encode time)\n");
