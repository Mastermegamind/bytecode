#!/usr/bin/env php
<?php

function fail(string $message, int $code = 1): never
{
    fwrite(STDERR, $message . PHP_EOL);
    exit($code);
}

function u32le(string $bytes, int &$offset): int
{
    if (strlen($bytes) < $offset + 4) {
        fail('truncated container');
    }
    $value = unpack('V', substr($bytes, $offset, 4))[1];
    $offset += 4;
    return $value;
}

function u64le(string $bytes, int &$offset): int
{
    if (strlen($bytes) < $offset + 8) {
        fail('truncated container');
    }
    $parts = unpack('Vlo/Vhi', substr($bytes, $offset, 8));
    $offset += 8;
    return $parts['lo'] + ($parts['hi'] << 32);
}

function take(string $bytes, int &$offset, int $length): string
{
    if ($length < 0 || strlen($bytes) < $offset + $length) {
        fail('truncated container');
    }
    $value = substr($bytes, $offset, $length);
    $offset += $length;
    return $value;
}

function parse_bytc(string $path): array
{
    $bytes = file_get_contents($path);
    if ($bytes === false) {
        fail("cannot read {$path}");
    }
    if (substr($bytes, 0, 4) !== 'BYTC') {
        fail("not a BYTC container: {$path}");
    }

    $offset = 4;
    $version = u32le($bytes, $offset);
    if ($version !== 1 && $version !== 2) {
        fail("{$path}: unsupported container version {$version}");
    }
    $phpVersionId = u32le($bytes, $offset);
    $backendId = take($bytes, $offset, u32le($bytes, $offset));
    $backendFormat = take($bytes, $offset, u32le($bytes, $offset));
    $cipherId = null;
    $keyId = '';
    if ($version === 2) {
        $cipherId = u32le($bytes, $offset);
        $keyId = take($bytes, $offset, u32le($bytes, $offset));
    }
    $headerSize = $offset;
    $nonce = take($bytes, $offset, u32le($bytes, $offset));
    $tag = take($bytes, $offset, u32le($bytes, $offset));
    $ciphertext = take($bytes, $offset, u64le($bytes, $offset));
    if ($offset !== strlen($bytes)) {
        fail("{$path}: trailing bytes after ciphertext");
    }

    return compact('bytes', 'version', 'phpVersionId', 'backendId', 'backendFormat', 'cipherId', 'keyId', 'headerSize', 'nonce', 'tag', 'ciphertext');
}

function verify_container(string $path): array
{
    $container = parse_bytc($path);
    if ($container['phpVersionId'] !== PHP_VERSION_ID) {
        fail("{$path}: PHP_VERSION_ID {$container['phpVersionId']} does not match " . PHP_VERSION_ID);
    }
    $isPhp = $container['backendId'] === 'php-zend-opdump' && $container['backendFormat'] === 'OPD2';
    $isAsset = $container['backendId'] === 'bytecode-asset' && $container['backendFormat'] === 'RAW1';
    if (!$isPhp && !$isAsset) {
        fail("{$path}: unsupported backend {$container['backendId']}/{$container['backendFormat']}");
    }
    if ($container['version'] === 2 && $container['cipherId'] !== 1) {
        fail("{$path}: unsupported cipher_id {$container['cipherId']}");
    }
    if (strlen($container['nonce']) !== 12 || strlen($container['tag']) !== 16) {
        fail("{$path}: unsupported nonce/tag length");
    }
    return [
        'path' => $path,
        'backend' => $container['backendId'],
        'backend_format' => $container['backendFormat'],
        'sha256' => hash('sha256', $container['bytes']),
        'size' => strlen($container['bytes']),
    ];
}

if ($argc !== 2 || in_array($argv[1] ?? '', ['-h', '--help'], true)) {
    fwrite(STDERR, "Usage: bytecode-verify <manifest.json|encoded-file>\n");
    fwrite(STDERR, "\nValidates BYTC headers, manifest hashes, sizes, and bytecode.map consistency.\n");
    exit(($argc === 2 && in_array($argv[1], ['-h', '--help'], true)) ? 0 : 2);
}

$target = $argv[1];
$baseDir = is_dir($target) ? $target : dirname($target);
$files = [];

if (is_dir($target)) {
    $manifestPath = rtrim($target, DIRECTORY_SEPARATOR) . DIRECTORY_SEPARATOR . 'bytecode.manifest.json';
} else {
    $manifestPath = $target;
}

if (is_file($manifestPath) && substr($manifestPath, -5) === '.json') {
    $manifest = json_decode(file_get_contents($manifestPath), true);
    if (!is_array($manifest) || ($manifest['format'] ?? '') !== 'bytecode-manifest-v1') {
        fail("invalid manifest: {$manifestPath}");
    }
    $baseDir = dirname($manifestPath);
    $mapName = $manifest['map'] ?? 'bytecode.map';
    $mapPath = $baseDir . DIRECTORY_SEPARATOR . $mapName;
    $mapOutputs = [];
    if (is_file($mapPath)) {
        foreach (file($mapPath, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [] as $line) {
            if ($line[0] === '#') {
                continue;
            }
            $parts = explode("\t", $line, 2);
            if (count($parts) !== 2 || $parts[0] === '' || $parts[1] === '') {
                fail("invalid map line in {$mapPath}");
            }
            $mapOutputs[$parts[1]] = $parts[0];
            $mappedPath = $baseDir . DIRECTORY_SEPARATOR . $parts[1];
            if (!is_file($mappedPath)) {
                fail("{$mapPath}: mapped container missing: {$parts[1]}");
            }
        }
    } else {
        fail("manifest map missing: {$mapPath}");
    }
    foreach ($manifest['files'] ?? [] as $entry) {
        $output = $entry['output'] ?? '';
        $backend = $entry['backend'] ?? 'php-zend-opdump';
        if ($backend === 'php-zend-opdump' && !isset($mapOutputs[$output])) {
            fail("{$mapPath}: missing output for manifest entry {$output}");
        }
        $path = $baseDir . DIRECTORY_SEPARATOR . $output;
        $result = verify_container($path);
        if (($entry['backend'] ?? '') !== '' && $entry['backend'] !== $result['backend']) {
            fail("{$path}: manifest backend mismatch");
        }
        $expectedFormat = $entry['backend_format'] ?? ($backend === 'php-zend-opdump' ? 'OPD2' : '');
        if ($expectedFormat !== '' && $expectedFormat !== $result['backend_format']) {
            fail("{$path}: manifest backend_format mismatch");
        }
        if (($entry['sha256'] ?? '') !== $result['sha256']) {
            fail("{$path}: manifest sha256 mismatch");
        }
        if (($entry['size'] ?? 0) !== $result['size']) {
            fail("{$path}: manifest size mismatch");
        }
        $files[] = $path;
    }

    $sigPath = $baseDir . DIRECTORY_SEPARATOR . 'bytecode.manifest.sig';
    if (!is_file($sigPath)) {
        fail("manifest signature missing: {$sigPath}");
    }
    $sig = trim(file_get_contents($sigPath));
    if (!preg_match('/\A[0-9a-f]{64}\z/', $sig)) {
        fail("{$sigPath}: malformed signature (expected 64 hex chars)");
    }
    // Cryptographic verification needs the same IKM the loader resolves via
    // BYTECODE_KEY/OPDUMP_KEY -- license-mode (RSA-wrapped DEK) builds can
    // only get a structural check here without also implementing an RSA
    // unwrap in this tool, so this stays a hex-shape check in that case.
    $vendorKeyFile = getenv('BYTECODE_VENDOR_KEY_FILE') ?: dirname(__DIR__, 2) . DIRECTORY_SEPARATOR . 'build' . DIRECTORY_SEPARATOR . 'vendor-secret.key';
    $fileKey = is_file($vendorKeyFile) ? trim((string) file_get_contents($vendorKeyFile)) : '';
    $ikmHex = getenv('BYTECODE_KEY') ?: getenv('OPDUMP_KEY') ?: getenv('BYTECODE_VENDOR_KEY') ?: $fileKey;
    if (preg_match('/\A[0-9a-fA-F]{64}\z/', $ikmHex)) {
        $sigKey = hash_hkdf('sha256', hex2bin($ikmHex), 32, 'bytecode-manifest-auth', '');
        $expected = hash_hmac('sha256', file_get_contents($manifestPath) . "\0" . file_get_contents($mapPath), $sigKey);
        if (!hash_equals($expected, $sig)) {
            fail("{$sigPath}: signature mismatch (wrong key, or manifest/map tampered)");
        }
    }

    // Vendor seal (bytecode.seal.json): structural digest check always; full
    // Ed25519 signature check when a vendor public key PEM is provided via
    // BYTECODE_VENDOR_PUBKEY or OPDUMP_VENDOR_PUBKEY_FILE -- the same anchor the
    // loader trusts. This lets a build be verified end-to-end before shipping.
    $sealPath = $baseDir . DIRECTORY_SEPARATOR . 'bytecode.seal.json';
    if (is_file($sealPath)) {
        $seal = json_decode(file_get_contents($sealPath), true);
        if (!is_array($seal) || ($seal['format'] ?? '') !== 'bytecode-seal-v1' || ($seal['alg'] ?? '') !== 'Ed25519') {
            fail("invalid bytecode.seal.json: {$sealPath}");
        }
        $manifestSha = hash_file('sha256', $manifestPath);
        $mapSha = hash_file('sha256', $mapPath);
        if (($seal['manifest_sha256'] ?? '') !== $manifestSha) {
            fail("{$sealPath}: manifest_sha256 does not match bytecode.manifest.json");
        }
        if (($seal['map_sha256'] ?? '') !== $mapSha) {
            fail("{$sealPath}: map_sha256 does not match bytecode.map");
        }
        $licensePath = $baseDir . DIRECTORY_SEPARATOR . 'bytecode.license.json';
        $licenseSha = is_file($licensePath) ? hash_file('sha256', $licensePath) : null;
        if ($licenseSha !== null) {
            if (($seal['license_sha256'] ?? '') !== $licenseSha) {
                fail("{$sealPath}: license_sha256 does not match bytecode.license.json");
            }
        } elseif (isset($seal['license_sha256'])) {
            fail("{$sealPath}: seal covers a bytecode.license.json that is missing");
        }

        $pubKey = getenv('BYTECODE_VENDOR_PUBKEY') ?: getenv('OPDUMP_VENDOR_PUBKEY_FILE') ?: '';
        if ($pubKey !== '') {
            if (!is_file($pubKey)) {
                fail("vendor public key does not exist: {$pubKey}");
            }
            $message = "bytecode-seal-v1\n"
                . "manifest:{$manifestSha}\n"
                . "map:{$mapSha}\n"
                . 'license:' . ($licenseSha ?? '-') . "\n";
            $signature = base64_decode((string) ($seal['signature'] ?? ''), true);
            if ($signature === false || strlen($signature) !== 64) {
                fail("{$sealPath}: malformed Ed25519 signature");
            }
            $msgTmp = tempnam(sys_get_temp_dir(), 'seal-msg');
            $sigTmp = tempnam(sys_get_temp_dir(), 'seal-sig');
            file_put_contents($msgTmp, $message);
            file_put_contents($sigTmp, $signature);
            $descriptors = [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']];
            $proc = proc_open(
                ['openssl', 'pkeyutl', '-verify', '-pubin', '-inkey', $pubKey, '-rawin', '-in', $msgTmp, '-sigfile', $sigTmp],
                $descriptors,
                $pipes
            );
            $stdout = $stderr = '';
            if (is_resource($proc)) {
                fclose($pipes[0]);
                $stdout = stream_get_contents($pipes[1]);
                $stderr = stream_get_contents($pipes[2]);
                fclose($pipes[1]);
                fclose($pipes[2]);
                $exit = proc_close($proc);
            } else {
                $exit = 1;
            }
            @unlink($msgTmp);
            @unlink($sigTmp);
            if ($exit !== 0 || !str_contains($stdout . $stderr, 'Signature Verified Successfully')) {
                fail("{$sealPath}: Ed25519 seal signature is NOT valid for {$pubKey}");
            }
            echo "vendor seal: Ed25519 signature verified against {$pubKey}", PHP_EOL;
        } else {
            echo "vendor seal: digests match (set BYTECODE_VENDOR_PUBKEY to verify the Ed25519 signature)", PHP_EOL;
        }
    }
} else {
    verify_container($target);
    $files[] = $target;
}

echo 'verified ', count($files), ' file(s) metadata/hash/map consistency', PHP_EOL;
