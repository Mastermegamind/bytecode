#!/usr/bin/env php
<?php

declare(strict_types=1);

require_once __DIR__ . '/bytecode-common.php';

function usage(): void
{
    fwrite(STDERR, <<<'USAGE'
Usage:
  bytecode-obfuscate [options] <source-file-or-dir>... <output-dir>
  bytecode-obfuscate [options] --out <output-dir> <source-file-or-dir>...

Conservatively obfuscates PHP source while preserving OOP/PSR/MVC/PDO-facing
symbols. It renames non-parameter local variables inside safe function/method
bodies only. Classes, namespaces, methods, functions, properties, constants,
parameters, superglobals, globals, and dynamic-variable-sensitive bodies are
left intact.

Options:
  --include-assets         Copy .html/.htm/.css/.js/.mjs/.twig/.blade.php too.
  --exclude <glob>         Exclude paths. Repeatable. Also supports --exclude=<glob>.
  --out <dir>, -o <dir>    Output directory. Alternative to final positional argument.
  --report-json            Print JSON summary.
  -h, --help               Show this help.

USAGE);
}

function fail(string $message, int $code = 1): never
{
    fwrite(STDERR, $message . PHP_EOL);
    exit($code);
}

function take_option_value(array &$args, string $option): string
{
    array_shift($args);
    if (!$args) {
        fail("{$option} requires a value", 2);
    }
    return array_shift($args);
}

function token_text(mixed $token): string
{
    return is_array($token) ? $token[1] : $token;
}

function glob_to_regex(string $glob): string
{
    $regex = '';
    for ($i = 0, $n = strlen($glob); $i < $n; $i++) {
        $c = $glob[$i];
        $regex .= $c === '*' ? '.*' : ($c === '?' ? '.' : preg_quote($c, '#'));
    }
    return '#\A' . $regex . '\z#';
}

function is_excluded(string $rel, array $excludes): bool
{
    foreach ($excludes as $pattern) {
        if (preg_match(glob_to_regex($pattern), $rel)) {
            return true;
        }
    }
    return false;
}

function to_rel(string $base, string $path): string
{
    $rel = substr($path, strlen($base));
    $rel = ltrim($rel, '/\\');
    return str_replace('\\', '/', $rel);
}

function source_kind(string $path): ?string
{
    if (str_ends_with(strtolower(str_replace('\\', '/', $path)), '.blade.php')) {
        return 'asset';
    }
    return match (strtolower(pathinfo($path, PATHINFO_EXTENSION))) {
        'php' => 'php',
        'html', 'htm', 'css', 'js', 'mjs', 'twig' => 'asset',
        default => null,
    };
}

function path_parts(string $path): array
{
    $path = str_replace('\\', '/', $path);
    $prefix = '';
    if (preg_match('#\A[A-Za-z]:/#', $path) === 1) {
        $prefix = substr($path, 0, 2);
        $path = substr($path, 2);
    }
    $parts = array_values(array_filter(explode('/', trim($path, '/')), static fn (string $part): bool => $part !== ''));
    if ($prefix !== '') {
        array_unshift($parts, $prefix);
    }
    return $parts;
}

function path_from_parts(array $parts): string
{
    if (!$parts) {
        return DIRECTORY_SEPARATOR;
    }
    if (preg_match('#\A[A-Za-z]:\z#', $parts[0]) === 1) {
        $drive = array_shift($parts);
        return $drive . DIRECTORY_SEPARATOR . implode(DIRECTORY_SEPARATOR, $parts);
    }
    return DIRECTORY_SEPARATOR . implode(DIRECTORY_SEPARATOR, $parts);
}

function common_base(array $paths): string
{
    $common = path_parts(array_shift($paths));
    foreach ($paths as $path) {
        $parts = path_parts($path);
        $limit = min(count($common), count($parts));
        $next = [];
        for ($i = 0; $i < $limit; $i++) {
            if ($common[$i] !== $parts[$i]) {
                break;
            }
            $next[] = $common[$i];
        }
        $common = $next;
    }
    return path_from_parts($common);
}

function is_ignored_variable(string $name): bool
{
    static $ignored = [
        '$this' => true,
        '$GLOBALS' => true,
        '$_SERVER' => true,
        '$_GET' => true,
        '$_POST' => true,
        '$_FILES' => true,
        '$_COOKIE' => true,
        '$_SESSION' => true,
        '$_REQUEST' => true,
        '$_ENV' => true,
        '$http_response_header' => true,
        '$argc' => true,
        '$argv' => true,
    ];
    return isset($ignored[$name]);
}

function next_non_ws(array $tokens, int $i, int $end): ?int
{
    for ($j = $i + 1; $j < $end; $j++) {
        if (is_array($tokens[$j]) && in_array($tokens[$j][0], [T_WHITESPACE, T_COMMENT, T_DOC_COMMENT], true)) {
            continue;
        }
        return $j;
    }
    return null;
}

function prev_non_ws(array $tokens, int $i, int $start): ?int
{
    for ($j = $i - 1; $j >= $start; $j--) {
        if (is_array($tokens[$j]) && in_array($tokens[$j][0], [T_WHITESPACE, T_COMMENT, T_DOC_COMMENT], true)) {
            continue;
        }
        return $j;
    }
    return null;
}

function matching_token(array $tokens, int $open, string $left, string $right): ?int
{
    $depth = 0;
    for ($i = $open, $n = count($tokens); $i < $n; $i++) {
        $text = token_text($tokens[$i]);
        if ($text === $left) {
            $depth++;
        } elseif ($text === $right) {
            $depth--;
            if ($depth === 0) {
                return $i;
            }
        }
    }
    return null;
}

function function_body_has_hazard(array $tokens, int $start, int $end): bool
{
    static $calls = [
        'compact' => true,
        'extract' => true,
        'get_defined_vars' => true,
        'parse_str' => true,
        'import_request_variables' => true,
        'call_user_func' => true,
        'call_user_func_array' => true,
    ];

    for ($i = $start; $i <= $end; $i++) {
        $token = $tokens[$i];
        if (is_array($token)) {
            if ($token[0] === T_GLOBAL || $token[0] === T_STATIC || $token[0] === T_FN || $token[0] === T_FUNCTION) {
                return true;
            }
            if ($token[0] === T_STRING && isset($calls[strtolower($token[1])])) {
                $next = next_non_ws($tokens, $i, $end + 1);
                if ($next !== null && token_text($tokens[$next]) === '(') {
                    return true;
                }
            }
            if (defined('T_DOLLAR_OPEN_CURLY_BRACES') && $token[0] === T_DOLLAR_OPEN_CURLY_BRACES) {
                return true;
            }
            if (defined('T_CURLY_OPEN') && $token[0] === T_CURLY_OPEN) {
                return true;
            }
            continue;
        }
        if ($token === '$') {
            $next = next_non_ws($tokens, $i, $end + 1);
            if ($next !== null && is_array($tokens[$next]) && $tokens[$next][0] === T_VARIABLE) {
                return true;
            }
        }
    }
    return false;
}

function collect_header_variables(array $tokens, int $start, int $bodyOpen): array
{
    $preserve = [];
    for ($i = $start; $i < $bodyOpen; $i++) {
        if (is_array($tokens[$i]) && $tokens[$i][0] === T_VARIABLE) {
            $preserve[$tokens[$i][1]] = true;
        }
    }
    return $preserve;
}

function obfuscate_function_body(array &$tokens, int $bodyOpen, int $bodyClose, array $preserve): int
{
    if (function_body_has_hazard($tokens, $bodyOpen + 1, $bodyClose - 1)) {
        return 0;
    }

    $map = [];
    $renamed = 0;
    for ($i = $bodyOpen + 1; $i < $bodyClose; $i++) {
        if (!is_array($tokens[$i]) || $tokens[$i][0] !== T_VARIABLE) {
            continue;
        }
        $name = $tokens[$i][1];
        if (isset($preserve[$name]) || is_ignored_variable($name)) {
            continue;
        }
        $prev = prev_non_ws($tokens, $i, $bodyOpen + 1);
        if ($prev !== null && token_text($tokens[$prev]) === '->') {
            continue;
        }
        if (!isset($map[$name])) {
            $map[$name] = '$_v' . count($map);
            $renamed++;
        }
        $tokens[$i][1] = $map[$name];
    }
    return $renamed;
}

function obfuscate_php_source(string $source, array &$stats): string
{
    $tokens = token_get_all($source);
    $renamedVariables = 0;
    $processedFunctions = 0;
    $skippedFunctions = 0;

    for ($i = 0, $n = count($tokens); $i < $n; $i++) {
        if (!is_array($tokens[$i]) || $tokens[$i][0] !== T_FUNCTION) {
            continue;
        }

        $parenOpen = null;
        for ($j = $i + 1; $j < $n; $j++) {
            $text = token_text($tokens[$j]);
            if ($text === '(') {
                $parenOpen = $j;
                break;
            }
            if ($text === ';' || $text === '{') {
                break;
            }
        }
        if ($parenOpen === null) {
            continue;
        }
        $parenClose = matching_token($tokens, $parenOpen, '(', ')');
        if ($parenClose === null) {
            continue;
        }

        $bodyOpen = null;
        for ($j = $parenClose + 1; $j < $n; $j++) {
            $text = token_text($tokens[$j]);
            if ($text === '{') {
                $bodyOpen = $j;
                break;
            }
            if ($text === ';') {
                break;
            }
        }
        if ($bodyOpen === null) {
            continue;
        }
        $bodyClose = matching_token($tokens, $bodyOpen, '{', '}');
        if ($bodyClose === null) {
            continue;
        }

        $renamed = obfuscate_function_body($tokens, $bodyOpen, $bodyClose, collect_header_variables($tokens, $i, $bodyOpen));
        if ($renamed > 0) {
            $renamedVariables += $renamed;
            $processedFunctions++;
        } else {
            $skippedFunctions++;
        }
        $i = $bodyClose;
    }

    $stats['functions_obfuscated'] = $processedFunctions;
    $stats['functions_skipped'] = $skippedFunctions;
    $stats['variables_renamed'] = $renamedVariables;
    return implode('', array_map('token_text', $tokens));
}

$args = array_slice($argv, 1);
if (isset($args[0]) && in_array($args[0], ['-h', '--help'], true)) {
    usage();
    exit(0);
}

$includeAssets = false;
$reportJson = false;
$excludes = [];
$out = null;
while ($args) {
    $arg = $args[0];
    if ($arg === '--include-assets') {
        $includeAssets = true;
        array_shift($args);
        continue;
    }
    if ($arg === '--report-json') {
        $reportJson = true;
        array_shift($args);
        continue;
    }
    if ($arg === '--exclude') {
        $excludes[] = take_option_value($args, '--exclude');
        continue;
    }
    if (str_starts_with($arg, '--exclude=')) {
        $excludes[] = substr($arg, strlen('--exclude='));
        array_shift($args);
        continue;
    }
    if ($arg === '--out' || $arg === '-o') {
        $out = take_option_value($args, $arg);
        continue;
    }
    if (str_starts_with($arg, '--out=')) {
        $out = substr($arg, strlen('--out='));
        array_shift($args);
        continue;
    }
    if ($arg === '--') {
        array_shift($args);
        break;
    }
    if ($arg !== '' && $arg[0] === '-') {
        usage();
        exit(2);
    }
    break;
}

if ($out === null && count($args) < 2) {
    usage();
    exit(2);
}
if ($out === null) {
    $out = array_pop($args);
}
if ($args === []) {
    usage();
    exit(2);
}

$sources = [];
foreach ($args as $source) {
    if (!file_exists($source)) {
        fail("source path does not exist: {$source}");
    }
    $real = realpath($source);
    if ($real === false) {
        fail("cannot resolve source path: {$source}");
    }
    $sources[] = $real;
}

if (!is_dir($out) && !@mkdir($out, 0777, true) && !is_dir($out)) {
    fail("cannot create output directory: {$out}");
}
$outAbs = realpath($out);
if ($outAbs === false) {
    fail("cannot resolve output directory: {$out}");
}

$multiSource = count($sources) > 1;
$commonInputs = [];
foreach ($sources as $source) {
    $commonInputs[] = $multiSource ? dirname($source) : (is_dir($source) ? $source : dirname($source));
}
$relativeBase = common_base($commonInputs);
$files = [];

foreach ($sources as $source) {
    if (is_file($source)) {
        $kind = source_kind($source);
        if ($kind === 'php' || ($includeAssets && $kind === 'asset')) {
            $rel = $multiSource ? to_rel($relativeBase, $source) : basename($source);
            if (!is_excluded($rel, $excludes)) {
                $files[] = [$source, $rel, $kind];
            }
        }
        continue;
    }
    $iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($source, FilesystemIterator::SKIP_DOTS));
    foreach ($iterator as $fileInfo) {
        if (!$fileInfo->isFile()) {
            continue;
        }
        $path = $fileInfo->getPathname();
        $kind = source_kind($path);
        if ($kind !== 'php' && !($includeAssets && $kind === 'asset')) {
            continue;
        }
        $rel = to_rel($multiSource ? $relativeBase : $source, $path);
        if (!is_excluded($rel, $excludes)) {
            $files[] = [$path, $rel, $kind];
        }
    }
}
sort($files);

$manifest = [
    'format' => 'bytecode-obfuscate-v1',
    'tool_version' => bytecode_project_version(),
    'created_at' => gmdate('c'),
    'source_root' => str_replace('\\', '/', $relativeBase),
    'output_root' => str_replace('\\', '/', $outAbs),
    'files' => [],
];

foreach ($files as [$source, $rel, $kind]) {
    $dest = $outAbs . DIRECTORY_SEPARATOR . $rel;
    @mkdir(dirname($dest), 0777, true);
    $stats = ['functions_obfuscated' => 0, 'functions_skipped' => 0, 'variables_renamed' => 0];
    if ($kind === 'php') {
        $input = file_get_contents($source);
        if ($input === false) {
            fail("cannot read {$source}");
        }
        $output = obfuscate_php_source($input, $stats);
        if (file_put_contents($dest, $output) === false) {
            fail("cannot write {$dest}");
        }
    } else {
        if (!copy($source, $dest)) {
            fail("cannot copy asset {$source} to {$dest}");
        }
    }
    $manifest['files'][] = [
        'source' => $rel,
        'output' => $rel,
        'kind' => $kind,
        'functions_obfuscated' => $stats['functions_obfuscated'],
        'functions_skipped' => $stats['functions_skipped'],
        'variables_renamed' => $stats['variables_renamed'],
        'sha256' => hash_file('sha256', $dest),
        'size' => filesize($dest),
    ];
    fwrite(STDOUT, "{$source} -> {$dest}\n");
}

file_put_contents(
    $outAbs . DIRECTORY_SEPARATOR . 'bytecode.obfuscate.json',
    json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL
);

if ($reportJson) {
    echo json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), PHP_EOL;
} else {
    printf("bytecode-obfuscate: wrote %d file(s)\n", count($manifest['files']));
}
