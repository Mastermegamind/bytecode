{
  "folders": [
    {
      "name": "bytecode",
      "path": "."
    }
  ],
  "settings": {
    // --- Editor ---
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [100],
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,

    // --- C / Zend extension ---
    "C_Cpp.default.cStandard": "c17",
    "C_Cpp.default.includePath": [
      "${workspaceFolder}/php/src",
      "/usr/include/php/*/main",
      "/usr/include/php/*/Zend",
      "/usr/include/php/*/TSRM",
      "/usr/include/php/*"
    ],
    "[c]": {
      "editor.defaultFormatter": "ms-vscode.cpptools",
      "editor.tabSize": 4
    },

    // --- PHP (test-ladder scripts under php/tests) ---
    "php.validate.enable": true,
    "php.validate.run": "onType",
    "[php]": {
      "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
    },
    "intelephense.files.exclude": [
      "**/.git/**",
      "**/build/**",
      "**/*.so"
    ],

    // --- Explorer ---
    "files.exclude": {
      "**/.git": true,
      "**/*.o": true,
      "**/*.lo": true,
      "**/.libs": true
    },
    "search.exclude": {
      "**/build": true,
      "**/.deps": true,
      "**/autom4te.cache": true
    },

    // --- Git ---
    "git.enableSmartCommit": true,
    "git.autofetch": true
  },
  "extensions": {
    "recommendations": [
      "ms-vscode.cpptools",
      "llvm-vs-code-extensions.vscode-clangd",
      "bmewburn.vscode-intelephense-client",
      "eamodio.gitlens",
      "mhutchie.git-graph",
      "streetsidesoftware.code-spell-checker",
      "PKief.material-icon-theme"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "gdb: php8.4 -d zend_extension=... -f test.php",
        "type": "cppdbg",
        "request": "launch",
        "program": "/usr/bin/php8.4",
        "args": ["-d", "zend_extension=${workspaceFolder}/php/src/modules/opdump.so", "-f", "${file}"],
        "cwd": "${workspaceFolder}/php",
        "MIMode": "gdb",
        "stopAtEntry": false
      }
    ]
  }
}
